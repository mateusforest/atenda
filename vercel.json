{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": { "api/meta-whatsapp.mjs":{"maxDuration":120}, "api/admin.mjs":{"maxDuration":90}, "api/inbox.mjs": { "maxDuration": 90 }, "api/billing.mjs": { "maxDuration": 120 }, "api/billing-cron.mjs":{"maxDuration":120} },
  "crons": [{ "path": "/api/billing-cron", "schedule": "15 8 * * *" }],
  "outputDirectory": "dist",
  "rewrites": [
    {"source":"/checkout","destination":"/checkout.html"},
    {"source":"/admin","destination":"/admin.html"},
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/login",
      "destination": "/acesso.html"
    },
    {
      "source": "/cadastro",
      "destination": "/acesso.html"
    }
  ]
}
