{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": { "api/inbox.mjs": { "maxDuration": 90 } },
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/login",
      "destination": "/acesso.html"
    },
    {
      "source": "/cadastro",
      "destination": "/acesso.html"
    }
  ]
}
